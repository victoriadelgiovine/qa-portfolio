              "    pm.response.to.have.status(422);",
              "});",
              "",
              "pm.test(\"TC-D04: Retorna el código de error CONSULTA_IRRELEVANTE\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.eql('CONSULTA_IRRELEVANTE');",
              "    pm.expect(jsonData).to.have.property('mensaje');",
              "});"
            ],
